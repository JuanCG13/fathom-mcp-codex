FATHOM_API_KEY=your_fathom_api_key

# Optional multi-account mode. If this is set, it takes precedence over
# FATHOM_API_KEY. Tools can then use account ids such as "personal" or "inzaiq".
FATHOM_ACCOUNTS='[
  {"id":"personal","label":"Personal","apiKey":"your_personal_fathom_api_key"},
  {"id":"inzaiq","label":"InzaiQ","apiKey":"your_inzaiq_fathom_api_key"}
]'
FATHOM_DEFAULT_ACCOUNT=inzaiq

# Optional multi-account mode without JSON. This is recommended for Windows
# Codex Desktop users editing config.toml by hand.
FATHOM_ACCOUNT_PERSONAL_API_KEY=your_personal_fathom_api_key
FATHOM_ACCOUNT_PERSONAL_LABEL=Personal
FATHOM_ACCOUNT_INZAIQ_API_KEY=your_inzaiq_fathom_api_key
FATHOM_ACCOUNT_INZAIQ_LABEL=InzaiQ
FATHOM_ACCOUNT_LEADS_API_KEY=your_leads_fathom_api_key
FATHOM_ACCOUNT_LEADS_LABEL=Leads
FATHOM_ACCOUNT_INTERNO_API_KEY=your_interno_fathom_api_key
FATHOM_ACCOUNT_INTERNO_LABEL=Interno
FATHOM_ACCOUNT_JOTA_API_KEY=your_jota_fathom_api_key
FATHOM_ACCOUNT_JOTA_LABEL=Jota

# Optional. Used only by the verify_fathom_webhook tool.
# Fathom returns this secret when you create a webhook.
FATHOM_WEBHOOK_SECRET=whsec_your_fathom_webhook_secret

# Backward-compatible alias supported by this server.
FATHOM_WEBHOOK_API_KEY=whsec_your_fathom_webhook_secret

# Optional override for testing or proxies.
FATHOM_BASE_URL=https://api.fathom.ai/external/v1
