FATHOM_API_KEY=your_fathom_api_key

# Optional multi-account mode. If this is set, it takes precedence over
# FATHOM_API_KEY. Tools can then use account ids such as "primary" or "engineering".
FATHOM_ACCOUNTS='[
  {"id":"primary","label":"Primary","apiKey":"your_primary_fathom_api_key"},
  {"id":"engineering","label":"Engineering","apiKey":"your_engineering_fathom_api_key"}
]'
FATHOM_DEFAULT_ACCOUNT=engineering

# Optional multi-account mode without JSON. This is recommended for Windows
# Codex Desktop users editing config.toml by hand.
FATHOM_ACCOUNT_PRIMARY_API_KEY=your_primary_fathom_api_key
FATHOM_ACCOUNT_PRIMARY_LABEL=Primary
FATHOM_ACCOUNT_ENGINEERING_API_KEY=your_engineering_fathom_api_key
FATHOM_ACCOUNT_ENGINEERING_LABEL=Engineering
FATHOM_ACCOUNT_SALES_API_KEY=your_sales_fathom_api_key
FATHOM_ACCOUNT_SALES_LABEL=Sales
FATHOM_ACCOUNT_OPERATIONS_API_KEY=your_operations_fathom_api_key
FATHOM_ACCOUNT_OPERATIONS_LABEL=Operations
FATHOM_ACCOUNT_CLIENT_API_KEY=your_client_fathom_api_key
FATHOM_ACCOUNT_CLIENT_LABEL=Client

# Optional. Used only by the verify_fathom_webhook tool.
# Fathom returns this secret when you create a webhook.
FATHOM_WEBHOOK_SECRET=whsec_your_fathom_webhook_secret

# Backward-compatible alias supported by this server.
FATHOM_WEBHOOK_API_KEY=whsec_your_fathom_webhook_secret

# Optional override for testing or proxies.
FATHOM_BASE_URL=https://api.fathom.ai/external/v1
