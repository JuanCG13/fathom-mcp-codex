FATHOM_API_KEY=your_fathom_api_key

# Optional. Used only by the verify_fathom_webhook tool.
# Fathom returns this secret when you create a webhook.
FATHOM_WEBHOOK_SECRET=whsec_your_fathom_webhook_secret

# Backward-compatible alias supported by this server.
FATHOM_WEBHOOK_API_KEY=whsec_your_fathom_webhook_secret

# Optional override for testing or proxies.
FATHOM_BASE_URL=https://api.fathom.ai/external/v1
