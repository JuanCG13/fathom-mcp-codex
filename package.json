{
  "name": "@codex-plugins/fathom-mcp",
  "version": "1.0.0",
  "description": "Codex plugin and MCP server for Fathom AI Notetaker.",
  "type": "module",
  "bin": {
    "fathom-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    ".codex-plugin",
    ".mcp.json",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "codex-plugin",
    "mcp",
    "fathom",
    "fathom-ai",
    "notetaker",
    "meetings",
    "transcripts"
  ],
  "author": {
    "name": "InzaiQ LLC",
    "url": "https://www.inzaiq.com/"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
