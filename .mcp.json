{
  "mcpServers": {
    "fathom": {
      "type": "stdio",
      "command": "node",
      "args": ["./dist/src/index.js"],
      "env": {
        "FATHOM_API_KEY": "${FATHOM_API_KEY}",
        "FATHOM_WEBHOOK_SECRET": "${FATHOM_WEBHOOK_SECRET}",
        "FATHOM_WEBHOOK_API_KEY": "${FATHOM_WEBHOOK_API_KEY}",
        "FATHOM_BASE_URL": "${FATHOM_BASE_URL}"
      },
      "note": "Local MCP server for Fathom AI Notetaker. Requires FATHOM_API_KEY. Run npm install && npm run build after modifying source."
    }
  }
}
