{
  "mcpServers": {
    "fathom": {
      "type": "stdio",
      "command": "node",
      "args": ["./dist/index.js"],
      "env": {
        "FATHOM_API_KEY": "${FATHOM_API_KEY}",
        "FATHOM_ACCOUNTS": "${FATHOM_ACCOUNTS}",
        "FATHOM_DEFAULT_ACCOUNT": "${FATHOM_DEFAULT_ACCOUNT}",
        "FATHOM_ACCOUNT_PRIMARY_API_KEY": "${FATHOM_ACCOUNT_PRIMARY_API_KEY}",
        "FATHOM_ACCOUNT_PRIMARY_LABEL": "${FATHOM_ACCOUNT_PRIMARY_LABEL}",
        "FATHOM_ACCOUNT_ENGINEERING_API_KEY": "${FATHOM_ACCOUNT_ENGINEERING_API_KEY}",
        "FATHOM_ACCOUNT_ENGINEERING_LABEL": "${FATHOM_ACCOUNT_ENGINEERING_LABEL}",
        "FATHOM_ACCOUNT_SALES_API_KEY": "${FATHOM_ACCOUNT_SALES_API_KEY}",
        "FATHOM_ACCOUNT_SALES_LABEL": "${FATHOM_ACCOUNT_SALES_LABEL}",
        "FATHOM_ACCOUNT_OPERATIONS_API_KEY": "${FATHOM_ACCOUNT_OPERATIONS_API_KEY}",
        "FATHOM_ACCOUNT_OPERATIONS_LABEL": "${FATHOM_ACCOUNT_OPERATIONS_LABEL}",
        "FATHOM_ACCOUNT_CLIENT_API_KEY": "${FATHOM_ACCOUNT_CLIENT_API_KEY}",
        "FATHOM_ACCOUNT_CLIENT_LABEL": "${FATHOM_ACCOUNT_CLIENT_LABEL}",
        "FATHOM_WEBHOOK_SECRET": "${FATHOM_WEBHOOK_SECRET}",
        "FATHOM_WEBHOOK_API_KEY": "${FATHOM_WEBHOOK_API_KEY}",
        "FATHOM_BASE_URL": "${FATHOM_BASE_URL}"
      },
      "note": "Local MCP server for Fathom AI Notetaker. Requires FATHOM_API_KEY and Node.js 20 or newer."
    }
  }
}
