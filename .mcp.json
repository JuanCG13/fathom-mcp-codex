{
  "mcpServers": {
    "fathom": {
      "type": "stdio",
      "command": "node",
      "args": ["./dist/index.js"],
      "env": {
        "FATHOM_API_KEY": "${FATHOM_API_KEY}",
        "FATHOM_ACCOUNTS": "${FATHOM_ACCOUNTS}",
        "FATHOM_DEFAULT_ACCOUNT": "${FATHOM_DEFAULT_ACCOUNT}",
        "FATHOM_ACCOUNT_PERSONAL_API_KEY": "${FATHOM_ACCOUNT_PERSONAL_API_KEY}",
        "FATHOM_ACCOUNT_PERSONAL_LABEL": "${FATHOM_ACCOUNT_PERSONAL_LABEL}",
        "FATHOM_ACCOUNT_INZAIQ_API_KEY": "${FATHOM_ACCOUNT_INZAIQ_API_KEY}",
        "FATHOM_ACCOUNT_INZAIQ_LABEL": "${FATHOM_ACCOUNT_INZAIQ_LABEL}",
        "FATHOM_ACCOUNT_LEADS_API_KEY": "${FATHOM_ACCOUNT_LEADS_API_KEY}",
        "FATHOM_ACCOUNT_LEADS_LABEL": "${FATHOM_ACCOUNT_LEADS_LABEL}",
        "FATHOM_ACCOUNT_INTERNO_API_KEY": "${FATHOM_ACCOUNT_INTERNO_API_KEY}",
        "FATHOM_ACCOUNT_INTERNO_LABEL": "${FATHOM_ACCOUNT_INTERNO_LABEL}",
        "FATHOM_ACCOUNT_JOTA_API_KEY": "${FATHOM_ACCOUNT_JOTA_API_KEY}",
        "FATHOM_ACCOUNT_JOTA_LABEL": "${FATHOM_ACCOUNT_JOTA_LABEL}",
        "FATHOM_WEBHOOK_SECRET": "${FATHOM_WEBHOOK_SECRET}",
        "FATHOM_WEBHOOK_API_KEY": "${FATHOM_WEBHOOK_API_KEY}",
        "FATHOM_BASE_URL": "${FATHOM_BASE_URL}"
      },
      "note": "Local MCP server for Fathom AI Notetaker. Requires FATHOM_API_KEY and Node.js 20 or newer."
    }
  }
}
